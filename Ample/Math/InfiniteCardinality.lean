theorem cardinal_le_iff (A B : Type) :
    cardinal A ≤ cardinal B ↔ ∃ f : A → B, Injective f := by
  constructor
  · intro h
    rcases h with ⟨A', B', hA, hB, hf⟩
    exact cardinalityLE_transport hA hB hf

  · intro hf
    exists A, B
    and_intros
    · exact sameCardinality_refl A
    · exact sameCardinality_refl B
    · exact hf

