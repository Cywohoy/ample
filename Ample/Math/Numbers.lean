theorem even_ne_odd (m : Nat) :
    ∀ n : Nat, 2 * m ≠ 2 * n + 1 := by
  induction m with
  | zero =>
      intro n h

      expand at h
      contradiction

  | succ m ih =>
      -- ih : ∀ n, 2 * m ≠ 2 * n + 1

      intro n h


      cases n with
      | zero =>
          expand at h


          have hZero : Nat.succ (2 * m) = 0 := by
            exact Nat.succ.inj h

          contradiction

      | succ n =>
          expand at h


          apply ih n
          exact Nat.succ.inj (Nat.succ.inj h)

