structure IsPartition {A : Type}
    (blocks : Set (Set A)) : Prop where
  nonempty : ∀ S, S ∈ blocks → ∃ x, x ∈ S
  cover : ∀ x, ∃ S, S ∈ blocks ∧ x ∈ S
  eq_of_in : ∀ S T, S ∈ blocks → T ∈ blocks →
    (∃ x, x ∈ S ∧ x ∈ T) → S = T

theorem equivalenceClasses_partition {A : Type}
    (R : Relation A)
    (hR : IsEquivalence R) :
    IsPartition
      (fun S => ∃ a, S = equivalenceClass R a) := by
  constructor
  · intro S hS
    unpack hS with ⟨a, ha⟩
    rw [ha]
    exists a
    exact hR.refl a

  · intro x
    exists equivalenceClass R x
    constructor
    · exists x
    · exact hR.refl x

  · intro S T hS hT hmeet
    unpack hS with ⟨a, ha⟩
    unpack hT with ⟨b, hb⟩
    rcases hmeet with ⟨x, ⟨hxS, hxT⟩⟩
    rw [ha] at hxS
    rw [hb] at hxT
    rw [ha, hb]
    apply equivalenceClass_eq R hR
    apply hR.trans
    · apply hR.symm
      exact hxS

    · exact hxT

def sameBlock {A : Type} (blocks : Set (Set A)) :
    Relation A :=
  fun x y => ∃ S, S ∈ blocks ∧ x ∈ S ∧ y ∈ S

theorem sameBlock_equivalence {A : Type}
    (blocks : Set (Set A))
    (h : IsPartition blocks) :
    IsEquivalence (sameBlock blocks) := by
  constructor
  · intro x
    rcases h.cover x with ⟨S, ⟨hS, hx⟩⟩
    exists S

  · intro x y hxy
    rcases hxy with ⟨S, ⟨hS, ⟨hx, hy⟩⟩⟩
    exists S

  · intro x y z hxy hyz
    rcases hxy with ⟨S, ⟨hS, ⟨hx, hy⟩⟩⟩
    rcases hyz with ⟨T, ⟨hT, ⟨hyT, hz⟩⟩⟩
    have hST : S = T := by
      apply h.eq_of_in S T hS hT
      exists y
    rw [← hST] at hz
    exists S

theorem sameBlock_class {A : Type} (blocks : Set (Set A))
