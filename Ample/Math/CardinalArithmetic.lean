  apply cardinal_eq_of_sameCardinality
  exists fun b => if b then (1 : Fin 2) else 0
  apply bijective_of_inverse _
    (fun i => if i.val = 1 then true else false)
  · intro b
    cases b with
    | false => rfl
    | true => rfl

  · intro i
    have hi : i.val = 0 ∨ i.val = 1 := by arith
    cases hi with
    | inl hi =>
        ext
        simp [hi]

    | inr hi =>
        ext
        simp [hi]

