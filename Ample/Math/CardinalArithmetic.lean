  intro hf

  unpack hA with ⟨n, hn⟩
  have hBn : cardinal B = cardinal (Fin n) := by
    rw [← hAB]
    exact hn

  unpack (cardinal_eq_iff B (Fin n)).mp hBn with ⟨b, hb⟩
  have hpre : ∀ i : Fin n,
      ∃ x : A, f x = inverseMap b hb i := by
    intro i
    exact hf (inverseMap b hb i)

