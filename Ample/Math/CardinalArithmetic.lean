theorem fin_injective_surjective (n : Nat)
    (f : Fin n → Fin n) :
    Injective f →
    Surjective f := by
  intro hf
  intro r
  by_contra hmissing
  cases n with
  | zero => exact Fin.elim0 r
  | succ n =>
    have hne : ∀ x : Fin (n + 1), (f x).val ≠ r.val := by
      intro x
      intro hval
      apply hmissing
      exists x
      ext
      exact hval

    let g (x : Fin (n + 1)) : Fin n :=
      { val := eraseIndex r.val (f x).val
        isLt := eraseIndex_lt r.isLt (f x).isLt (hne x) }
    have hg : Injective g := by
      intro x y hxy
      apply hf
      ext
      apply eraseIndex_injective (hne x) (hne y)
      apply_fun (fun x => x.val) at hxy
      exact hxy


    have hbound : n + 1 ≤ n := by
      apply fin_injective_le g hg
    arith

theorem finite_injective_surjective {A B : Type} (f : A → B)
    (hA : IsFinite A) :
    cardinal A = cardinal B →
    Injective f →
    Surjective f := by
  intro hAB
  intro hf
  unpack hA with ⟨n, hn⟩
  have hBn : cardinal B = cardinal (Fin n) := by
    rw [← hAB]
    exact hn
  unpack (cardinal_eq_iff A (Fin n)).mp hn with ⟨a, ha⟩
  unpack (cardinal_eq_iff B (Fin n)).mp hBn with ⟨b, hb⟩
  let F (i : Fin n) : Fin n := b (f (inverseMap a ha i))
  have hF : Injective F := by
    intro i j hij
    apply (inverseMap_bijective a ha).inj
    apply hf
    apply hb.inj
    exact hij

  intro y
  unpack fin_injective_surjective n F hF (b y) with ⟨i, hi⟩
  exists inverseMap a ha i
  apply hb.inj
  exact hi

theorem fin_choice {A : Type} (n : Nat)
    (P : Fin n → A → Prop) :
    (∀ i, ∃ a, P i a) →
    ∃ g : Fin n → A, ∀ i, P i (g i) := by
  induction n with
  | zero =>
    intro h
    exists (fun i => Fin.elim0 i)
    intro i
    exact Fin.elim0 i

  | succ n ih =>
    intro h

    unpack h 0 with ⟨a, ha⟩
    have ht : ∀ i : Fin n, ∃ a, P i.succ a := by
      intro i
      exact h i.succ

    unpack ih (fun i a => P i.succ a) ht with ⟨g, hg⟩

    exists Fin.cases a g
    intro i
    exact Fin.cases ha hg i

theorem finite_surjective_injective {A B : Type} (f : A → B)
    (hA : IsFinite A) :
    cardinal A = cardinal B →
    Surjective f →
    Injective f := by
