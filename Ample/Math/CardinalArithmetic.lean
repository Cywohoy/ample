  rw [← bool_cardinal, ← cardinal_arrow]
  apply cardinal_eq_of_sameCardinality
  exists characteristic
  apply bijective_of_inverse _ trueSet
  · exact trueSet_characteristic
  · exact characteristic_trueSet

